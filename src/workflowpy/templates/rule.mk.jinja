{% macro add_rule(rule, dryrun) %}
# Rule: {{ rule.rule_id }} ({{ rule.method_name }})
{% if rule.has_multiple_repeat_wildcards %}
define {{ rule.rule_id }}_template
{{ rule.make_targets | join(' ') }}{% if rule.make_targets | length > 1 %} &{% endif %}: {{ rule.make_prereqs | join(' ') }}{% if rule.prereqs_foreach_expr %} {{ rule.prereqs_foreach_expr }}{% endif %}

	workflowpy method {{ rule.method_name }} \
{% for key, value in rule.shell_kwargs_formatted().items() %}
